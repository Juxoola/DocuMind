# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── LM Studio / OpenAI-compatible API ──
LM_STUDIO_URL=http://localhost:1234/v1

# ── Embedding & Reranker ──
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
QUANTIZATION=4bit

# ── RAG Pipeline ──
RAG_TOP_K_PER_FILE=5
RAG_RERANK_POOL=30
RAG_FINAL_TOP_N=15
USE_RERANKER=true

# ── GGUF Models ──
# Directories to scan for GGUF files (semicolon-separated)
GGUF_SEARCH_DIRS=F:/llm
GGUF_SERVER_PORT=8081
GGUF_SERVER_HOST=127.0.0.1
GGUF_THREADS=0
GGUF_CTX_SIZE=32768
GGUF_GPU_LAYERS=-1

# ── Vision Model Defaults ──
VISION_TEMPERATURE=0.1
VISION_REPEAT_PENALTY=1.3
VISION_TOP_P=0.9
VISION_MIN_P=0.05
VISION_CONCURRENCY=4

# ── Chat Model Defaults ──
CHAT_TEMPERATURE=0.7
CHAT_REPEAT_PENALTY=1.1
CHAT_TOP_P=0.95
CHAT_MIN_P=0.05
