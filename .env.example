# DocuMind — Переменные окружения
# Скопируйте в .env и настройте

# ── Сервер ──
HOST=127.0.0.1
PORT=8000
RELOAD=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ── LLM ──
LM_STUDIO_URL=http://localhost:1234/v1
LLM_DEFAULT_API_KEY=lm-studio
LLM_DEFAULT_MODEL=gpt-4o
LM_STUDIO_HTTP_TIMEOUT=60

# ── Embedding ──
EMBEDDING_DEFAULT_API_KEY=lm-studio
EMBEDDING_DEFAULT_MODEL=text-embedding-ada-002

# ── RAG ──
EMBEDDING_MODEL_NAME=Qwen3-Embedding-0.6B-Q8_0.gguf
RERANKER_MODEL_NAME=qwen3-reranker-0.6b-q8_0.gguf
EMBEDDING_N_PARALLEL=2
RAG_TOP_K_PER_FILE=5
RAG_RERANK_POOL=30
RAG_FINAL_TOP_N=15
USE_RERANKER=true
RAG_QUERY_EXPANSION=true
RERANK_SCORE_THRESHOLD=0.1
MIN_FINAL_CHUNKS=5
RAG_RRF_K=60
RAG_TOP_K_RATIO=0.1

# ── GGUF ──
GGUF_SEARCH_DIRS=F:/llm;./models
GGUF_THREADS=0
GGUF_GPU_LAYERS=-1
GGUF_CTX_SIZE=16384
GGUF_CTX_EMBED_CHARS=4096

# ── Vision ──
VISION_TEMPERATURE=0.1
VISION_REPEAT_PENALTY=1.3
VISION_TOP_P=0.9
VISION_MIN_P=0.05
VISION_CONCURRENCY=4

# ── Chat ──
CHAT_TEMPERATURE=0.7

# ── Лимиты ──
UPLOAD_MAX_SIZE_MB=500
